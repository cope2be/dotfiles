auto-update = off
confirm-close-surface = false

window-padding-x = 5
window-padding-y = 5

window-theme = system
window-decoration = true

macos-titlebar-style = native

bell-features = no-audio,no-attention,no-system,no-title
notify-on-command-finish = never

adjust-underline-position = 6
shell-integration-features = no-cursor

cursor-opacity = 0.5
cursor-style = block
cursor-style-blink = false

font-size = 16

font-family = FantasqueSansM Nerd Font Mono
font-family-bold = FantasqueSansM Nerd Font Mono
font-family-italic = FantasqueSansM Nerd Font Mono
font-family-bold-italic = FantasqueSansM Nerd Font Mono

font-feature = -calt
font-feature = -liga
font-feature = -dlig

keybind = super+enter=new_window
keybind = super+shift+enter=toggle_fullscreen

keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+o=unbind

keybind = super+t=unbind
keybind = ctrl+shift+t=unbind

keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind

palette = 0=#393552
palette = 1=#eb6f92
palette = 2=#9ccfd8
palette = 3=#f6c177
palette = 4=#3e8fb0
palette = 5=#c4a7e7
palette = 6=#ea9a97
palette = 7=#e0def4
palette = 8=#6e6a86
palette = 9=#eb6f92
palette = 10=#9ccfd8
palette = 11=#f6c177
palette = 12=#3e8fb0
palette = 13=#c4a7e7
palette = 14=#ea9a97
palette = 15=#e0def4
background = #232136
foreground = #e0def4
cursor-color = #e0def4
cursor-text = #232136
selection-background = #44415a
selection-foreground = #e0def4
